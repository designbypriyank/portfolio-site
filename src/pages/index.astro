---
import Base from "../layouts/Base.astro";
import site from "../data/site.json";
import projects from "../data/projects.json";
---
<Base title={`${site.name} — ${site.role}`}>
  <!-- Hero: eyebrow · two-line headline (second line italic) · subhead.
       Left-aligned to the page container. -->
  <section class="hero">
    <div class="grid-lines" aria-hidden="true">
      <span class="h h1"></span><span class="h h2"></span><span class="v"></span>
      <span class="dot d1"></span><span class="dot d2"></span>
    </div>
    <div class="container hero-inner">
      <p class="kicker hero-eyebrow">Portfolio · {site.name.split(" ")[0]}</p>
      <h1>{site.name}<br /><em>{site.role}.</em></h1>
      <p class="lede">{site.bio[0]}</p>
    </div>
  </section>

  <!-- Work: full-bleed tinted band, cards in a 1 → 2 column grid -->
  <section id="work" class="band">
    <div class="container">
      <div class="band-head">
        <h2 class="kicker section-title">Selected work</h2>
        <span class="count">{String(projects.length).padStart(2, "0")} projects</span>
      </div>
      <div class="cards">
        {projects.map((p) => {
          const soon = p.status === "soon";
          const Tag = soon ? "div" : "a";
          const [role, duration, focus] = p.meta;
          return (
            <Tag class:list={["card", "reveal", p.theme, { soon }]} href={soon ? undefined : `/work/${p.slug}`}>
              <div class="card-media">
                <img src={p.cover} alt={p.coverAlt} loading="lazy" />
              </div>
              <div class="card-body">
                {focus && <p class="kicker card-kicker">{focus}</p>}
                <h3>{p.title}</h3>
                <ul class="meta">
                  {[role, duration].filter(Boolean).map((m) => <li>{m}</li>)}
                </ul>
                <p class="summary">{p.summary}</p>
              </div>
              <div class="card-foot">
                <span class:list={["btn", { "btn-soon": soon }]}>
                  {soon ? "Case study coming soon" : <>View case study <span class="arrow" aria-hidden="true">→</span></>}
                </span>
              </div>
            </Tag>
          );
        })}
      </div>
    </div>
  </section>

  <section id="about" class="container about reveal">
    <h2 class="kicker section-title">About</h2>
    <div class="about-body">
      {site.bio.map((para) => <p>{para}</p>)}
    </div>
  </section>

  <section id="contact" class="container contact reveal">
    <h2 class="kicker section-title">Contact</h2>
    <p>Open to internships and collaborations.</p>
    <div class="contact-links">
      {site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}
      {site.links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>)}
      {site.resume && <a href={site.resume} target="_blank" rel="noopener">Resume ↗</a>}
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero { position: relative; overflow: hidden; padding: 56px 0 64px; }
  .grid-lines { position: absolute; inset: 0; pointer-events: none; }
  .grid-lines .h { position: absolute; left: 0; right: 0; border-top: 1.5px dashed var(--line-strong); }
  .grid-lines .h1 { top: 22%; }
  .grid-lines .h2 { top: 84%; }
  /* vertical rule + dots sit 28px left of the container edge */
  .grid-lines .v, .grid-lines .dot { --edge: calc((100% - min(var(--container), 100% - 2 * var(--margin))) / 2); }
  .grid-lines .v { position: absolute; top: 0; bottom: 0; left: calc(var(--edge) - 28px); border-left: 1.5px dashed var(--line-strong); }
  .grid-lines .dot { position: absolute; width: 12px; height: 12px; border-radius: 50%; background: var(--muted); left: calc(var(--edge) - 34px); transform: translateY(-50%); }
  .grid-lines .d1 { top: 22%; }
  .grid-lines .d2 { top: 84%; }

  .hero-inner { position: relative; }
  .hero-eyebrow { color: var(--muted); }
  /* 36/44 phone → 48/60 tablet → 64/72 desktop, tracking −2% */
  h1 { font-size: 2.25rem; line-height: 2.75rem; letter-spacing: -0.02em; font-weight: 600; margin-top: 16px; }
  h1 em { font-style: italic; font-weight: 300; color: var(--ink-soft); }
  .lede { max-width: 60ch; color: var(--ink-soft); margin-top: 16px; font-size: 1rem; line-height: 1.5rem; }

  /* ---------- Work band ---------- */
  .band { background: var(--band); padding: var(--section-y) 0; }
  .band-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 24px; }
  .section-title { color: var(--muted); margin: 0 0 24px; }
  .band-head .section-title { margin: 0; }
  .count { font-size: 0.875rem; color: var(--muted); }

  /* < 680: one column · ≥ 680: two columns · 24px gutter throughout */
  .cards { display: grid; grid-template-columns: 1fr; gap: var(--grid-gap); }

  /* Card: 16px inset, 24px radius, 16px rhythm between parts */
  .card {
    display: flex; flex-direction: column; gap: 16px;
    padding: 16px; border-radius: 24px;
    background: var(--surface);
    box-shadow: 0 9px 17px rgba(16, 20, 28, 0.05);
    text-decoration: none; color: inherit;
    transition: box-shadow .3s ease, transform .3s ease;
  }
  a.card:hover { box-shadow: 0 16px 40px rgba(16, 20, 28, 0.10); transform: translateY(-3px); }

  .card-media {
    aspect-ratio: 16 / 9; border-radius: 16px; overflow: hidden;
    background: var(--accent-tint);
    display: grid; place-items: center; padding: 6% 10%;
  }
  .card-media img { width: 100%; height: 100%; object-fit: contain; transition: transform .5s ease; }
  a.card:hover .card-media img { transform: scale(1.03); }
  .theme-iitr .card-media { padding: 0; background: #0b1f4a; }
  .theme-iitr .card-media img { object-fit: cover; }

  .card-body { display: flex; flex-direction: column; gap: 8px; padding: 0 8px; }
  .card-kicker { color: var(--accent-ink); }
  .card h3 { font-size: 1.75rem; line-height: 2rem; font-weight: 500; letter-spacing: -0.01em; margin-top: 4px; }
  .meta { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; font-size: 0.875rem; line-height: 1.25rem; color: var(--muted); }
  .meta li + li::before { content: "•"; margin: 0 10px; }
  .summary { font-size: 1rem; line-height: 1.5rem; color: var(--ink-soft); margin-top: 4px; }

  /* Button pinned to the card bottom so paired cards line up */
  .card-foot { margin-top: auto; padding-top: 16px; border-top: 1px solid var(--line); }
  .btn {
    display: flex; align-items: center; justify-content: center; gap: 8px;
    height: 52px; border-radius: 8px;
    background: var(--ink); color: #fff; font-size: 1rem;
  }
  .btn .arrow { transition: transform .3s ease; }
  a.card:hover .btn .arrow { transform: translateX(4px); }
  .btn-soon { background: var(--accent-tint); color: var(--accent-ink); font-size: 0.9375rem; }

  /* ---------- About / contact ---------- */
  .about { padding-top: calc(var(--section-y) + 16px); }
  .contact { padding: calc(var(--section-y) + 16px) 0 calc(var(--section-y) + 32px); }
  .about-body { display: grid; gap: 14px; max-width: 62ch; font-size: var(--fs-lg); color: var(--ink-soft); }
  .contact p { font-size: var(--fs-lg); color: var(--ink-soft); }
  .contact-links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 20px; }
  .contact-links a { text-decoration: none; border: 1px solid var(--line-strong); border-radius: 999px; padding: 10px 18px; font-weight: 500; }
  .contact-links a:hover { background: var(--ink); color: #fff; border-color: var(--ink); }

  /* ---------- Breakpoints ---------- */
  @media (max-width: 809.98px) { .grid-lines { display: none; } }
  @media (min-width: 680px) { .cards { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 810px) {
    .hero { padding: 64px 0 72px; }
    h1 { font-size: 3rem; line-height: 3.75rem; }
  }
  @media (min-width: 1280px) {
    .hero { padding: 72px 0 80px; }
    h1 { font-size: 4rem; line-height: 4.5rem; }
    .lede { font-size: 1.125rem; line-height: 1.75rem; }
  }
</style>
