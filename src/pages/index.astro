---
import Base from "../layouts/Base.astro";
import site from "../data/site.json";
import projects from "../data/projects.json";
import FrameIntro from "../components/FrameIntro.astro";
---
<Base title={`${site.name} — ${site.role}`}>
  <FrameIntro>
    <section class="hero">
      <div class="grid-lines" aria-hidden="true">
        <span class="h h1"></span><span class="h h2"></span><span class="v"></span>
        <span class="dot d1"></span><span class="dot d2"></span>
      </div>
      <div class="wrap hero-inner">
        <p class="eyebrow">~portfolio~</p>
        <h1>{site.name}</h1>
        <p class="role">{site.role}</p>
        <p class="lede">{site.bio[0]}</p>
      </div>
    </section>
  </FrameIntro>

  <section id="work" class="wrap work">
    <h2 class="section-title">Selected work</h2>
    <div class="cards">
      {projects.map((p) => {
        const Tag = p.status === "soon" ? "div" : "a";
        return (
          <Tag class:list={["card", "reveal", p.theme, { soon: p.status === "soon" }]} href={p.status === "soon" ? undefined : `/work/${p.slug}`}>
            <div class="card-media">
              <img src={p.cover} alt={p.coverAlt} loading="lazy" />
            </div>
            <div class="card-body">
              <div class="card-head">
                <h3>{p.title}</h3>
                {p.status === "soon"
                  ? <span class="badge">Case study coming soon</span>
                  : <span class="arrow" aria-hidden="true">→</span>}
              </div>
              <p class="summary">{p.summary}</p>
              <ul class="meta">{p.meta.map((m) => <li>{m}</li>)}</ul>
            </div>
          </Tag>
        );
      })}
    </div>
  </section>

  <section id="about" class="wrap about reveal">
    <h2 class="section-title">About</h2>
    <div class="about-body">
      {site.bio.map((para) => <p>{para}</p>)}
    </div>
  </section>

  <section id="contact" class="wrap contact reveal">
    <h2 class="section-title">Contact</h2>
    <p>Open to internships and collaborations.</p>
    <div class="contact-links">
      {site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}
      {site.links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>)}
      {site.resume && <a href={site.resume} target="_blank" rel="noopener">Resume ↗</a>}
    </div>
  </section>
</Base>

<style>
  /* Hero — echoes the dashed grid + dots from the Figma case study covers */
  .hero { position: relative; width: 100%; background: var(--bg); overflow: hidden; padding: clamp(72px, 12vw, 140px) 0 clamp(64px, 10vw, 120px); border-bottom: 1px solid var(--line); }
  .grid-lines { position: absolute; inset: 0; pointer-events: none; }
  .grid-lines .h { position: absolute; left: 0; right: 0; border-top: 1.5px dashed var(--line-strong); }
  .grid-lines .h1 { top: 28%; }
  .grid-lines .h2 { top: 78%; }
  .grid-lines .v { position: absolute; top: 0; bottom: 0; left: max(calc((100vw - var(--max)) / 2 + var(--gutter) - 28px), 10px); border-left: 1.5px dashed var(--line-strong); }
  .grid-lines .dot { position: absolute; width: 12px; height: 12px; border-radius: 50%; background: var(--muted); left: max(calc((100vw - var(--max)) / 2 + var(--gutter) - 34px), 4px); transform: translateY(-50%); }
  .grid-lines .d1 { top: 28%; }
  .grid-lines .d2 { top: 78%; }

  .hero-inner { position: relative; }
  h1 { font-size: var(--fs-2xl); margin-top: 10px; }
  .role { font-size: var(--fs-xl); font-weight: 300; font-style: italic; color: var(--ink-soft); margin-top: 6px; }
  .lede { max-width: 58ch; color: var(--ink-soft); margin-top: 24px; font-size: var(--fs-lg); line-height: 1.55; }

  .section-title { font-size: var(--fs-sm); text-transform: uppercase; letter-spacing: 0.12em; color: var(--muted); font-weight: 600; margin-bottom: 28px; }

  .work { padding-top: clamp(56px, 8vw, 96px); }
  .cards { display: grid; gap: clamp(28px, 4vw, 48px); }
  .card {
    display: grid; grid-template-columns: 1.25fr 1fr; gap: 0;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg);
    overflow: hidden; text-decoration: none; color: inherit;
    transition: box-shadow .3s ease, transform .3s ease, border-color .3s ease;
  }
  a.card:hover { box-shadow: var(--shadow); transform: translateY(-3px); border-color: var(--line-strong); }
  .card-media { background: var(--accent-tint); padding: clamp(20px, 4vw, 44px); display: grid; place-items: center; }
  .card-media img { border-radius: 8px; box-shadow: 0 12px 40px rgba(15,23,42,.14); transition: transform .5s ease; }
  a.card:hover .card-media img { transform: scale(1.02); }
  .theme-iitr .card-media { padding: 0; background: #0b1f4a; }
  .theme-iitr .card-media img { border-radius: 0; box-shadow: none; }
  .card-body { padding: clamp(24px, 4vw, 44px); display: flex; flex-direction: column; gap: 14px; justify-content: center; }
  .card-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .card h3 { font-size: var(--fs-xl); font-style: italic; font-weight: 400; color: var(--accent); }
  .theme-iitr h3 { font-style: normal; font-weight: 700; }
  .arrow { font-size: 1.5rem; color: var(--accent); transition: transform .3s ease; }
  a.card:hover .arrow { transform: translateX(4px); }
  .summary { font-size: var(--fs-lg); color: var(--ink-soft); line-height: 1.45; }
  .meta { list-style: none; padding: 0; margin: 4px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .meta li { font-size: var(--fs-xs); border: 1px solid var(--line); border-radius: 999px; padding: 4px 10px; color: var(--ink-soft); background: var(--bg); }
  .badge { font-size: var(--fs-xs); background: var(--accent-tint); color: var(--accent-ink); padding: 4px 10px; border-radius: 999px; font-weight: 600; }

  .about, .contact { padding-top: clamp(64px, 9vw, 112px); }
  .about-body { display: grid; gap: 14px; max-width: 62ch; font-size: var(--fs-lg); color: var(--ink-soft); }
  .contact p { font-size: var(--fs-lg); color: var(--ink-soft); }
  .contact-links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 20px; }
  .contact-links a { text-decoration: none; border: 1px solid var(--line-strong); border-radius: 999px; padding: 10px 18px; font-weight: 500; }
  .contact-links a:hover { background: var(--ink); color: #fff; border-color: var(--ink); }

  @media (max-width: 820px) {
    .card { grid-template-columns: 1fr; }
    .grid-lines { display: none; }
  }
</style>
