      "blocks": [
        {
          "type": "split",
          "groups": [
            {
              "heading": "Goal",
              "body": "To understand the information architecture & structure of the landing page across different Ed-tech platforms, and how they are managing the navigations between multiple products and large amount of content."
            },
            {
              "heading": "Insights",
              "bullets": [
                "Relevance between landing page (website) and dashboard (platform)",
                "Trade-off between no of features or content vs clarity for navigation across the platform",
                "Consistency across the pages of the platform, smooth and intuitive experience"
              ]
            }
          ],
          "image": {
            "src": "/images/twig/benchmarking.webp",
