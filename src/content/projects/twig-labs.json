            },
            {
              "cells": [
                "Intuitive navigation for smooth user experience",
                "Trade-off between no of features or content vs clarity",
                "Clean dashboard, for intuitive navigation across the platform. Optimisation and prioritisation of necessary features"
              ]
            },
            {
              "cells": [
                "Consistency across all the pages",
                "Trade-off between no of features or content vs clarity",
                "Clean dashboard, for intuitive navigation across the platform. Optimisation and prioritisation of necessary features"
              ]
            }
          ]
