    {
      "id": "problem",
      "eyebrow": "framing the gaps",
      "title": "Problem Statement",
      "blocks": [
        {
          "type": "quote",
          "body": "How might we help students and their parents to trust and navigate Twig from the first visit on the website to dashboard inside the platform, so that it feels like one consistent journey rather than two disconnected products?"
        }
      ]
    },
