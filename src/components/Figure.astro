---
interface Props { src: string; alt: string; caption?: string; width?: number; height?: number; frame?: boolean; }
const { src, alt, caption, width, height, frame = true } = Astro.props;
---
<figure class:list={["fig", { framed: frame }]}>
  <a href={src} target="_blank" rel="noopener" class="zoom" aria-label={`Open full size: ${alt}`}>
    <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
  </a>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .fig { margin: 0; }
  .zoom { display: block; cursor: zoom-in; }
  .framed img { border-radius: var(--radius-sm); border: 1px solid var(--line); background: var(--surface); box-shadow: var(--shadow); }
  figcaption { margin-top: 12px; font-style: italic; font-weight: 300; color: var(--muted); font-size: var(--fs-md); }
</style>
