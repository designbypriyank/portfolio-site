---
/**
 * FrameIntro — "It's not the view. It's how you frame it."
 *
 * Scroll-scrubbed and short: roughly one full scroll steps through the framed views,
 * one more pushes into the last sketched window, which squares up to the screen and
 * reveals the slotted content (the home hero). Every pixel of scroll moves it, in both
 * directions, until you land.
 *
 * Once landed, the intro collapses out of the page (scrolling up stops at the hero instead
 * of replaying the room) and is skipped for the rest of the browser session.
 *
 * Landscape uses 16:9 frames (room extended to fill the screen); portrait uses 9:16.
 * Skipped for prefers-reduced-motion, without JS, or when the page opens below the top / at a #hash.
 */
interface Props {
  frames?: number;
}
const { frames = 10 } = Astro.props;
const list = Array.from({ length: frames }, (_, i) => String(i + 1).padStart(2, "0"));
---
<section class="frame-intro" data-frames={frames} aria-label="Intro">
  <div class="fi-stage">
    <div class="fi-room" aria-hidden="true">
      <div class="fi-zoom">
        {list.map((n, i) => (
          <picture class:list={{ on: i === 0 }}>
            <source media="(min-aspect-ratio: 1/1)" srcset={`/images/intro/wide-${n}.webp`} width="1920" height="1080" />
            <img
              src={`/images/intro/frame-${n}.webp`}
              alt=""
              width="720"
              height="1280"
              decoding="async"
              fetchpriority={i === 0 || i === frames - 1 ? "high" : "low"}
            />
          </picture>
        ))}
      </div>
      <div class="fi-hud fi-count"><span class="fi-n">01</span> / {list.length}</div>
      <div class="fi-hud fi-cue"><span class="fi-cue-text">Scroll</span><i></i></div>
      <button class="fi-skip" type="button">Skip intro ↓</button>
      <div class="fi-bar"></div>
    </div>

    <div class="fi-view">
      <slot />
    </div>
  </div>
</section>

<style>
  /* ---------- Fallback (no JS / reduced motion / skipped / landed): just the hero ---------- */
  .frame-intro { position: relative; }
  .fi-room { display: none; }
  .fi-view > :global(*) { min-height: calc(100svh - var(--fi-header, 61px)); display: flex; flex-direction: column; justify-content: center; }

  /* ---------- Live: sticky stage pinned over the page for the length of the intro ---------- */
  .frame-intro.is-live { height: calc(var(--fi-pin, 200vh) + var(--fi-buffer, 200vh) + 100svh); margin-top: calc(-1 * var(--fi-header, 61px)); }
  .frame-intro.is-live .fi-stage { position: sticky; top: 0; height: 100svh; overflow: hidden; z-index: 30; }
  .frame-intro.is-live .fi-room { display: block; position: absolute; inset: 0; background: #cbc6c1; overflow: hidden; }
  .frame-intro.is-live .fi-view {
    position: absolute; inset: 0; padding-top: var(--fi-header, 61px); background: var(--bg);
    clip-path: polygon(0 0, 0 0, 0 0, 0 0); will-change: clip-path;
  }

  :global(html.fi-lock) { overflow: hidden; }
  .fi-zoom { position: absolute; inset: 0; will-change: transform; transform-origin: 50% 50%; }
  .fi-zoom picture { position: absolute; inset: 0; opacity: 0; transition: opacity .2s linear; }
  .fi-zoom picture.on { opacity: 1; }
  .fi-zoom img { width: 100%; height: 100%; max-width: none; object-fit: cover; object-position: 50% 50%; }

  .fi-hud {
    position: absolute; z-index: 2; color: #fff; mix-blend-mode: difference; pointer-events: none;
    font-size: 12px; letter-spacing: .14em; text-transform: uppercase; font-variant-numeric: tabular-nums;
    transition: opacity .35s ease;
  }
  .fi-count { top: 22px; left: var(--gutter); }
  .fi-cue { bottom: 26px; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .fi-cue i { width: 1px; height: 36px; background: currentColor; transform-origin: top; animation: fi-drip 1.6s ease-in-out infinite; }
  @keyframes fi-drip { 0% { transform: scaleY(0); } 50% { transform: scaleY(1); } 100% { transform: scaleY(1); opacity: 0; } }
  .fi-skip {
    position: absolute; z-index: 2; top: 14px; right: var(--gutter);
    font: inherit; font-size: 12px; letter-spacing: .08em; color: var(--ink);
    background: rgba(255, 255, 255, .55); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
    border: 1px solid rgba(0, 0, 0, .08); border-radius: 999px; padding: 7px 14px; cursor: pointer;
    transition: opacity .35s ease, background .2s ease;
  }
  .fi-skip:hover { background: rgba(255, 255, 255, .85); }
  .fi-bar {
    position: absolute; z-index: 2; left: 0; bottom: 0; height: 2px; width: 100%; background: #fff;
    mix-blend-mode: difference; transform-origin: left; transform: scaleX(0); transition: opacity .35s ease;
  }
  @media (max-width: 600px) { .fi-cue { bottom: 12px; } .fi-cue-text { display: none; } }

  /* While the room is on screen the site header steps aside */
  :global(body.fi-active .site-header) { opacity: 0; pointer-events: none; }
  :global(.site-header) { transition: opacity .5s ease; }
</style>

<script>
  type Pt = [number, number];
  // Opening of the drawn window in the last frame (TL, TR, BR, BL), traced in 9:16 source px (720 × 1280).
  const QUAD: Pt[] = [[395, 387], [454, 378], [455, 424], [395, 431]];
  const WIN = { w: 60, h: 53 };
  // Logical size of each artwork; the 16:9 room is the 9:16 frame centred on a wider canvas.
  const ART = { tall: { w: 720, h: 1280, ox: 0 }, wide: { w: 2276, h: 1280, ox: 778 } };

  // Scroll distances, in viewport heights. One full trackpad flick ≈ one viewport.
  const FRAMES_VH = 1.0;   // all frames
  const HOLD_VH = 0.15;    // a beat on the last window
  const ZOOM_VH = 1.0;     // through the window
  // Speed limits, so a fast flick still reads as frames changing rather than a skip.
  const FRAME_MS = 150;    // at most one frame change per this many ms
  const HOLD_MS = 280;     // the last window stays on screen at least this long before the push
  const ZOOM_MIN_MS = 1000; // the push into the window never takes less than this

  const KEY = "fi-seen";
  const seen = (() => { try { return sessionStorage.getItem(KEY) === "1"; } catch { return false; } })();
  const root = document.querySelector<HTMLElement>(".frame-intro");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const startAtTop = scrollY < 4 && !location.hash;

  if (root && !reduce && startAtTop && !seen) {
    const N = Number(root.dataset.frames);
    const stage = root.querySelector<HTMLElement>(".fi-stage")!;
    const zoomEl = root.querySelector<HTMLElement>(".fi-zoom")!;
    const view = root.querySelector<HTMLElement>(".fi-view")!;
    const pics = [...root.querySelectorAll<HTMLElement>(".fi-zoom picture")];
    const count = root.querySelector<HTMLElement>(".fi-n")!;
    const countBox = root.querySelector<HTMLElement>(".fi-count")!;
    const cue = root.querySelector<HTMLElement>(".fi-cue")!;
    const skip = root.querySelector<HTMLButtonElement>(".fi-skip")!;
    const bar = root.querySelector<HTMLElement>(".fi-bar")!;
    const header = document.querySelector<HTMLElement>(".site-header");
    const wideMQ = matchMedia("(min-aspect-ratio: 1/1)");

    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

    const PIN_VH = FRAMES_VH + HOLD_VH + ZOOM_VH;
    if (header) document.documentElement.style.setProperty("--fi-header", `${header.offsetHeight}px`);
    root.style.setProperty("--fi-pin", `${PIN_VH * 100}vh`);
    // extra pinned room so a hard flick can overshoot without carrying the stage away mid-animation
    root.style.setProperty("--fi-buffer", "200vh");
    root.classList.add("is-live");
    document.body.classList.add("fi-active");
    history.scrollRestoration = "manual";

    let cur = 0;
    const show = (i: number) => {
      if (i === cur) return;
      pics[cur].classList.remove("on");
      pics[i].classList.add("on");
      count.textContent = String(i + 1).padStart(2, "0");
      cur = i;
    };

    const geometry = () => {
      const W = stage.clientWidth, H = stage.clientHeight;
      const a = wideMQ.matches ? ART.wide : ART.tall;
      const s = Math.max(W / a.w, H / a.h);                 // object-fit: cover
      const offX = (W - a.w * s) / 2, offY = (H - a.h * s) / 2;
      const P = QUAD.map(([x, y]) => [offX + (x + a.ox) * s, offY + y * s] as Pt);
      return { W, H, s, P };
    };

    // Paint one state: which frame is showing, and how far the window push has gone (0–1).
    const paint = (frame: number, zRaw: number, y: number) => {
      const { W, H, s, P } = geometry();
      show(frame);

      const z = ease(zRaw);
      const cx = P.reduce((t, p) => t + p[0], 0) / 4, cy = P.reduce((t, p) => t + p[1], 0) / 4;
      const sMax = Math.max(W / (WIN.w * s), H / (WIN.h * s));
      const scale = Math.exp(lerp(0, Math.log(sMax), z));
      zoomEl.style.transformOrigin = `${cx}px ${cy}px`;
      zoomEl.style.transform = `scale(${scale})`;
      const g = ease(clamp((z - 0.7) / 0.3));               // square the sketchy opening up to the screen
      const SC: Pt[] = [[0, 0], [W, 0], [W, H], [0, H]];
      const Q = P.map(([x, yy], i) => [lerp(cx + (x - cx) * scale, SC[i][0], g), lerp(cy + (yy - cy) * scale, SC[i][1], g)]);
      view.style.clipPath = z <= 0
        ? "polygon(0 0,0 0,0 0,0 0)"
        : `polygon(${Q.map(([a, b]) => `${a.toFixed(1)}px ${b.toFixed(1)}px`).join(",")})`;

      document.body.classList.toggle("fi-active", z < 0.8);
      const hudOn = z <= 0.02;
      for (const el of [countBox, skip, bar]) el.style.opacity = hudOn ? "1" : "0";
      skip.style.pointerEvents = hudOn ? "auto" : "none";
      cue.style.opacity = y < H * 0.04 ? "1" : "0";
      bar.style.transform = `scaleX(${clamp(y / (PIN_VH * H))})`;
    };

    // The scroll sets where the intro should be; the playhead walks there at a capped pace:
    // one frame at a time, then a short beat on the last window, then the push.
    // Going back up runs the same path in reverse (push closes first, then frames step back).
    let fShown = 0, zShown = 0, lastStep = 0, raf = 0, landed = false, prev = performance.now();
    const root_ = document.documentElement;
    const loop = (now: number) => {
      const H = stage.clientHeight, pin = PIN_VH * H;
      const y = clamp(scrollY, 0, pin);
      const fTarget = Math.min(N - 1, Math.floor(clamp(y / (FRAMES_VH * H)) * N));
      const zTarget = clamp((y - (FRAMES_VH + HOLD_VH) * H) / (ZOOM_VH * H));
      const dt = Math.min(64, now - prev); prev = now;
      const maxDz = dt / ZOOM_MIN_MS;

      if (zShown > 0 && (fTarget < N - 1 || zTarget < zShown)) {
        // close the window first
        const goal = fTarget < N - 1 ? 0 : zTarget;
        zShown = Math.max(goal, zShown - Math.max(maxDz, (zShown - goal) * 0.15));
        if (zShown < 0.001) { zShown = 0; lastStep = now; }
      } else if (zShown === 0 && fShown !== fTarget) {
        if (now - lastStep >= FRAME_MS) { fShown += fTarget > fShown ? 1 : -1; lastStep = now; }
      } else if (fShown === N - 1 && zTarget > zShown && now - lastStep >= HOLD_MS) {
        zShown = Math.min(zTarget, zShown + Math.min(maxDz, Math.max((zTarget - zShown) * 0.15, maxDz * 0.25)));
        if (zTarget - zShown < 0.002) zShown = zTarget;
      }

      paint(fShown, zShown, y);

      // Scrolled past the end while the picture is still catching up: hold the page still until it does.
      const atEnd = scrollY >= pin - 1;
      root_.classList.toggle("fi-lock", atEnd && zShown < 1);
      if (atEnd && zShown >= 1) { land(); raf = 0; return; }

      const settled = fShown === fTarget && Math.abs(zShown - zTarget) < 0.002 && (zTarget === 0 || fShown === N - 1);
      raf = settled ? 0 : requestAnimationFrame(loop);
    };
    const kick = () => {
      if (landed) return;
      const pin = PIN_VH * stage.clientHeight;
      if (scrollY >= pin - 1) {
        root_.classList.add("fi-lock");                                // stop momentum right away
        if (scrollY > pin + stage.clientHeight) scrollTo({ top: pin, behavior: "instant" as ScrollBehavior });
      }
      if (!raf) { prev = performance.now(); raf = requestAnimationFrame(loop); }
    };

    // Landed: take the intro out of the page without moving anything on screen.
    function land() {
      landed = true;
      const pin = PIN_VH * stage.clientHeight;
      const y = scrollY > pin + 2 ? pin : scrollY;            // an overshoot lands exactly on the hero
      root!.classList.remove("is-live");
      document.body.classList.remove("fi-active");
      view.style.clipPath = "";
      zoomEl.style.transform = "";
      removeEventListener("scroll", kick);
      removeEventListener("resize", kick);
      root_.classList.remove("fi-lock");
      scrollTo({ top: Math.max(0, y - pin), behavior: "instant" as ScrollBehavior });
      try { sessionStorage.setItem(KEY, "1"); } catch {}
    }

    addEventListener("scroll", kick, { passive: true });
    addEventListener("resize", kick);
    skip.addEventListener("click", () => {
      fShown = N - 1; lastStep = performance.now() - HOLD_MS;   // jump to the last window, then push
      scrollTo({ top: PIN_VH * stage.clientHeight, behavior: "instant" as ScrollBehavior });
      kick();
    });
    paint(0, 0, 0);
  }
</script>
