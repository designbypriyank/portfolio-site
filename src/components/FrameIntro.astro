---
/**
 * FrameIntro — "It's not the view. It's how you frame it."
 *
 * Act 1  The screen pins and each scroll step swaps to the next framed view of the room.
 * Act 2  The sequence ends on the smallest window.
 * Act 3  The camera pushes into that drawn window; it grows to fill the screen and the
 *        slotted content (the home hero) is what was "outside" all along.
 * Then   The pin releases and the page scrolls normally.
 *
 * No JS / prefers-reduced-motion: the room is skipped and the slot renders as a normal hero.
 */
interface Props {
  /** Number of frames in /images/intro (frame-01.webp … frame-NN.webp). */
  frames?: number;
  /** Scroll distance per frame, in viewport heights. */
  step?: number;
  /** Scroll distance of the "through the window" act, in viewport heights. */
  zoom?: number;
}
const { frames = 10, step = 0.7, zoom = 1.6 } = Astro.props;
const list = Array.from({ length: frames }, (_, i) => String(i + 1).padStart(2, "0"));
---
<section class="frame-intro" data-frames={frames} data-step={step} data-zoom={zoom} aria-label="Intro">
  <div class="fi-stage">
    <div class="fi-room" aria-hidden="true">
      <div class="fi-zoom">
        {list.map((n, i) => (
          <div class:list={["fi-backdrop", { on: i === 0 }]} style={`background-image:url(/images/intro/blur-${n}.webp)`}></div>
        ))}
        <div class="fi-frame">
          {list.map((n, i) => (
            <img
              class:list={{ on: i === 0 }}
              src={`/images/intro/frame-${n}.webp`}
              alt=""
              width="720"
              height="1280"
              decoding="async"
              fetchpriority={i === 0 ? "high" : "low"}
              loading={i < 2 ? "eager" : "lazy"}
            />
          ))}
        </div>
      </div>
      <div class="fi-hud fi-count"><span class="fi-n">01</span> / {list.length}</div>
      <div class="fi-hud fi-cue"><span>Scroll</span><i></i></div>
      <button class="fi-skip" type="button">Skip intro ↓</button>
      <div class="fi-bar"></div>
    </div>

    <div class="fi-view">
      <slot />
    </div>
  </div>
</section>

<style>
  /* ---------- Fallback (no JS or reduced motion): just the hero ---------- */
  .frame-intro { position: relative; }
  .fi-room { display: none; }
  .fi-view { position: relative; }

  /* ---------- Enhanced ---------- */
  :global(.js) .frame-intro.is-live { height: var(--fi-len, 800vh); margin-top: calc(-1 * var(--fi-header, 61px)); }
  :global(.js) .frame-intro.is-live .fi-stage {
    position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; z-index: 30;
  }
  :global(.js) .frame-intro.is-live .fi-room {
    display: block; position: absolute; inset: 0; background: #cbc6c1; overflow: hidden;
  }
  :global(.js) .frame-intro.is-live .fi-view {
    position: absolute; inset: 0; background: var(--bg);
    clip-path: polygon(0 0, 0 0, 0 0, 0 0);
    will-change: clip-path;
    display: flex; flex-direction: column; justify-content: center;
  }
  :global(.js) .frame-intro.is-live .fi-view > :global(*) { flex: 1; display: flex; flex-direction: column; justify-content: center; }
  .frame-intro.is-done .fi-view { clip-path: none !important; }
  .frame-intro.is-done .fi-room { visibility: hidden; }

  .fi-zoom { position: absolute; inset: 0; will-change: transform; transform-origin: 50% 50%; }
  .fi-backdrop {
    position: absolute; inset: -6%; background-size: cover; background-position: center;
    filter: blur(28px) saturate(.9); opacity: 0; transition: opacity .5s ease;
  }
  .fi-backdrop.on { opacity: 1; }
  .fi-frame {
    position: absolute; top: 0; left: 50%; height: 100%; aspect-ratio: 9 / 16;
    transform: translateX(-50%); box-shadow: 0 0 120px rgba(0, 0, 0, .14);
  }
  .fi-frame img {
    position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; object-fit: cover;
    opacity: 0; transform: scale(1.035);
    transition: opacity .45s ease, transform .9s cubic-bezier(.2, .7, .2, 1);
  }
  .fi-frame img.on { opacity: 1; transform: none; }

  .fi-hud {
    position: absolute; z-index: 2; color: #fff; mix-blend-mode: difference; pointer-events: none;
    font-size: 12px; letter-spacing: .14em; text-transform: uppercase; font-variant-numeric: tabular-nums;
    transition: opacity .35s ease;
  }
  .fi-count { top: 22px; left: var(--gutter); }
  .fi-cue { bottom: 26px; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .fi-cue i { width: 1px; height: 36px; background: currentColor; transform-origin: top; animation: fi-drip 1.6s ease-in-out infinite; }
  @keyframes fi-drip { 0% { transform: scaleY(0); } 50% { transform: scaleY(1); } 100% { transform: scaleY(1); opacity: 0; } }
  .fi-skip {
    position: absolute; z-index: 2; top: 14px; right: var(--gutter);
    font: inherit; font-size: 12px; letter-spacing: .08em; color: var(--ink);
    background: rgba(255, 255, 255, .55); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
    border: 1px solid rgba(0, 0, 0, .08); border-radius: 999px; padding: 7px 14px; cursor: pointer;
    transition: opacity .35s ease, background .2s ease;
  }
  @media (max-width: 600px) { .fi-cue { bottom: 12px; } .fi-cue span { display: none; } }
  .fi-skip:hover { background: rgba(255, 255, 255, .85); }
  .fi-bar { position: absolute; z-index: 2; left: 0; top: 0; height: 2px; width: 100%; background: #fff; mix-blend-mode: difference; transform-origin: left; transform: scaleX(0); }

  /* While the room is on screen the site header steps aside */
  :global(body.fi-active .site-header) { opacity: 0; pointer-events: none; }
  :global(.site-header) { transition: opacity .4s ease; }
</style>

<script>
  type Pt = [number, number];
  // Opening of the drawn window in the last frame, traced from the sketch (source px, 720 × 1280).
  const QUAD: Pt[] = [[395, 387], [454, 378], [455, 424], [395, 431]]; // TL, TR, BR, BL
  const WIN = { w: 60, h: 53 };

  const root = document.querySelector<HTMLElement>(".frame-intro");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (root && !reduce) {
    const N = Number(root.dataset.frames);
    const STEP = Number(root.dataset.step);
    const ZOOM = Number(root.dataset.zoom);
    const stage = root.querySelector<HTMLElement>(".fi-stage")!;
    const zoomEl = root.querySelector<HTMLElement>(".fi-zoom")!;
    const view = root.querySelector<HTMLElement>(".fi-view")!;
    const imgs = [...root.querySelectorAll<HTMLImageElement>(".fi-frame img")];
    const backs = [...root.querySelectorAll<HTMLElement>(".fi-backdrop")];
    const count = root.querySelector<HTMLElement>(".fi-n")!;
    const cue = root.querySelector<HTMLElement>(".fi-cue")!;
    const hudCount = root.querySelector<HTMLElement>(".fi-count")!;
    const skip = root.querySelector<HTMLButtonElement>(".fi-skip")!;
    const bar = root.querySelector<HTMLElement>(".fi-bar")!;

    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

    // Pinned scroll = frames + zoom act; the section is one viewport taller so the pin can release.
    root.style.setProperty("--fi-len", `${(N * STEP + ZOOM) * 100 + 100}vh`);
    const header = document.querySelector<HTMLElement>(".site-header");
    if (header) root.style.setProperty("--fi-header", `${header.offsetHeight}px`); // sit under the header, full-bleed
    root.classList.add("is-live");

    // Warm the remaining frames after the first paint so swaps never flash.
    const idle = (window as any).requestIdleCallback ?? ((cb: () => void) => setTimeout(cb, 600));
    idle(() => imgs.forEach((im) => (im.loading = "eager")));

    let cur = 0;
    const setFrame = (i: number) => {
      if (i === cur) return;
      imgs[cur].classList.remove("on"); backs[cur].classList.remove("on");
      imgs[i].classList.add("on"); backs[i].classList.add("on");
      count.textContent = String(i + 1).padStart(2, "0");
      cur = i;
    };

    const render = () => {
      const W = stage.clientWidth, H = stage.clientHeight;
      const y = -root.getBoundingClientRect().top;          // scroll inside the intro
      const pinned = (N * STEP + ZOOM) * H;
      const seqEnd = N * STEP * H;

      setFrame(clamp(Math.floor(y / (STEP * H)), 0, N - 1));

      // Act 3: push into the window
      const z = ease(clamp((y - seqEnd) / (ZOOM * H)));
      const fw = (H * 9) / 16, fl = (W - fw) / 2, k = H / 1280;
      const P = QUAD.map(([x, yy]) => [fl + x * k, yy * k] as Pt);
      const cx = P.reduce((s, p) => s + p[0], 0) / 4, cy = P.reduce((s, p) => s + p[1], 0) / 4;
      const sMax = Math.max(W / (WIN.w * k), H / (WIN.h * k));
      const scale = Math.exp(lerp(0, Math.log(sMax), z));
      zoomEl.style.transformOrigin = `${cx}px ${cy}px`;
      zoomEl.style.transform = `scale(${scale})`;

      const g = ease(clamp((z - 0.72) / 0.28));             // square the sketchy window up to the screen
      const SC: Pt[] = [[0, 0], [W, 0], [W, H], [0, H]];
      const Q = P.map(([x, yy], i) => [
        lerp(cx + (x - cx) * scale, SC[i][0], g),
        lerp(cy + (yy - cy) * scale, SC[i][1], g),
      ]);
      view.style.clipPath = z <= 0
        ? "polygon(0 0,0 0,0 0,0 0)"
        : `polygon(${Q.map(([a, b]) => `${a.toFixed(1)}px ${b.toFixed(1)}px`).join(",")})`;

      const done = z >= 1;
      root.classList.toggle("is-done", done);
      document.body.classList.toggle("fi-active", z < 0.9 && y < pinned + H);

      // HUD
      const p = clamp(y / pinned);
      bar.style.transform = `scaleX(${p})`;
      cue.style.opacity = y > H * 0.25 ? "0" : "1";
      hudCount.style.opacity = skip.style.opacity = z > 0.02 ? "0" : "1";
      skip.style.pointerEvents = z > 0.02 ? "none" : "auto";
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => { render(); ticking = false; });
    };
    addEventListener("scroll", onScroll, { passive: true });
    addEventListener("resize", onScroll);

    skip.addEventListener("click", () => {
      const H = stage.clientHeight;
      const top = root.getBoundingClientRect().top + scrollY + (N * STEP + ZOOM) * H;
      window.scrollTo({ top, behavior: "auto" });
    });

    render();
  }
</script>
