---
import site from "../data/site.json";
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap row">
    <span>© {year} {site.name}</span>
    <span class="links">
      {site.links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
    </span>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--line); margin-top: 96px; padding: 28px 0 40px; font-size: var(--fs-sm); color: var(--muted); }
  .row { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .links { display: flex; gap: 20px; }
  a { text-decoration: none; }
  a:hover { color: var(--ink); }
</style>
