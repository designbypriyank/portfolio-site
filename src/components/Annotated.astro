---
/**
 * An image with numbered pins linked to a list of notes.
 * Hovering/focusing a note highlights its pin and vice versa.
 * Pin x/y are percentages of the image size.
 */
export interface Note { x: number; y: number; title: string; body: string; }
interface Props {
  src: string; alt: string; width: number; height: number;
  notes: Note[]; caption?: string; variant?: "sticky" | "plain";
}
const { src, alt, width, height, notes, caption, variant = "sticky" } = Astro.props;
---
<div class:list={["annotated", variant]} data-annotated>
  <figure>
    <div class="stage">
      <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
      {notes.map((n, i) => (
        <button class="pin" type="button" style={`left:${n.x}%;top:${n.y}%`} data-i={i} aria-label={`Note ${i + 1}: ${n.title}`}>
          {i + 1}
        </button>
      ))}
    </div>
    {caption && <figcaption>{caption}</figcaption>}
  </figure>
  <ol class="notes">
    {notes.map((n, i) => (
      <li class="note" data-i={i} tabindex="0">
        <span class="num" aria-hidden="true">{i + 1}</span>
        <div>
          <strong>{n.title}</strong>
          {n.body && <p>{n.body}</p>}
        </div>
      </li>
    ))}
  </ol>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-annotated]").forEach((root) => {
    const set = (i: string | null) => {
      root.querySelectorAll<HTMLElement>("[data-i]").forEach((el) => {
        el.classList.toggle("active", el.dataset.i === i);
      });
      root.classList.toggle("has-active", i !== null);
    };
    root.querySelectorAll<HTMLElement>("[data-i]").forEach((el) => {
      el.addEventListener("mouseenter", () => set(el.dataset.i ?? null));
      el.addEventListener("focus", () => set(el.dataset.i ?? null));
      el.addEventListener("mouseleave", () => set(null));
      el.addEventListener("blur", () => set(null));
      if (el.classList.contains("pin")) {
        el.addEventListener("click", () => {
          const note = root.querySelector<HTMLElement>(`.note[data-i="${el.dataset.i}"]`);
          note?.scrollIntoView({ behavior: "smooth", block: "nearest" });
          note?.focus({ preventScroll: true });
        });
      }
    });
  });
</script>

<style>
  .annotated { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, 340px); gap: clamp(20px, 3vw, 36px); align-items: start; }
  figure { margin: 0; }
  .stage { position: relative; }
  .stage img { border-radius: var(--radius-sm); border: 1px solid var(--line); background: var(--surface); box-shadow: var(--shadow); }
  figcaption { margin-top: 12px; font-style: italic; font-weight: 300; color: var(--muted); }

  .pin {
    position: absolute; transform: translate(-50%, -50%);
    width: 28px; height: 28px; border-radius: 50%;
    border: 2px solid #fff; background: var(--accent); color: #fff;
    font: 700 13px/1 var(--font-sans); cursor: pointer;
    box-shadow: 0 2px 8px rgba(0,0,0,.25);
    transition: transform .2s ease, opacity .2s ease;
  }
  .pin::after {
    content: ""; position: absolute; inset: -6px; border-radius: 50%;
    border: 2px solid var(--accent); opacity: .5;
    animation: ping 2.4s ease-out infinite;
  }
  @keyframes ping { 0% { transform: scale(.8); opacity: .6; } 80%,100% { transform: scale(1.5); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .pin::after { animation: none; } }
  .has-active .pin { opacity: .45; }
  .has-active .pin.active { opacity: 1; transform: translate(-50%, -50%) scale(1.2); }

  .notes { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .note {
    display: grid; grid-template-columns: 26px 1fr; gap: 12px;
    padding: 14px 16px; border-radius: 4px; outline-offset: 2px;
    transition: transform .2s ease, box-shadow .2s ease, opacity .2s ease;
  }
  .sticky .note { background: var(--note); box-shadow: 0 2px 6px rgba(0,0,0,.08); }
  .plain .note { background: var(--surface); border: 1px solid var(--line); }
  .has-active .note { opacity: .55; }
  .has-active .note.active { opacity: 1; transform: translateX(-4px); box-shadow: 0 6px 16px rgba(0,0,0,.12); }
  .num { width: 24px; height: 24px; border-radius: 50%; background: var(--accent); color: #fff; font-size: 12px; font-weight: 700; display: grid; place-items: center; margin-top: 1px; }
  .note strong { display: block; font-weight: 600; font-size: var(--fs-sm); color: var(--ink); }
  .note p { font-size: var(--fs-sm); color: var(--ink-soft); line-height: 1.5; margin-top: 2px; }

  @media (max-width: 900px) {
    .annotated { grid-template-columns: 1fr; }
    .pin { width: 22px; height: 22px; font-size: 11px; }
  }
</style>
