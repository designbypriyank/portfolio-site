---
interface Item { title: string; body: string; cta: string; color: string; button: string; border: string; icon: string; }
interface Props { items: Item[]; caption?: string; }
const { items, caption } = Astro.props;
// Lucide icons — the same set used in the Figma design
const icons: Record<string, string> = {
  library: '<path d="m16 6 4 14"/><path d="M12 6v14"/><path d="M8 8v12"/><path d="M4 4v16"/>',
  game: '<line x1="6" x2="10" y1="12" y2="12"/><line x1="8" x2="8" y1="10" y2="14"/><line x1="15" x2="15.01" y1="13" y2="13"/><line x1="18" x2="18.01" y1="11" y2="11"/><rect width="20" height="12" x="2" y="6" rx="2"/>',
  bot: '<path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/>',
  clipboard: '<rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/>',
};
---
<figure class="products-fig">
  <div class="panel">
    <div class="products">
      {items.map((p) => (
        <article class="product" style={`--p-bg:${p.color};--p-btn:${p.button};--p-border:${p.border}`}>
          <span class="rings" aria-hidden="true"></span>
          <span class="blob" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[p.icon] ?? ""} />
          </span>
          <h3>{p.title}</h3>
          <p>{p.body}</p>
          <span class="p-btn">{p.cta}</span>
        </article>
      ))}
    </div>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .products-fig { margin: 0; }
  .panel { background: var(--panel); border-radius: var(--radius-lg); padding: clamp(16px, 3vw, 40px); }
  .products { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(12px, 1.8vw, 28px); }
  .product { position: relative; overflow: hidden; background: var(--p-bg); color: #fff; border-radius: 24px; padding: 76px 18px 18px; display: flex; flex-direction: column; gap: 10px; min-height: 380px; transition: transform .3s ease; }
  .product:hover { transform: translateY(-4px); }
  .rings { position: absolute; right: -36px; top: -36px; width: 125px; height: 125px; border-radius: 50%;
    border: 2px solid rgba(255,255,255,.35); box-shadow: 0 0 0 12px var(--p-bg), 0 0 0 14px rgba(255,255,255,.3), inset 0 0 0 12px var(--p-bg), inset 0 0 0 14px rgba(255,255,255,.3); }
  .blob { position: absolute; top: 24px; left: 18px; width: 72px; height: 72px; display: grid; place-items: center;
    background: color-mix(in srgb, #fff 55%, var(--p-bg)); color: color-mix(in srgb, #000 55%, var(--p-bg)); border-radius: 42% 58% 55% 45% / 48% 42% 58% 52%; }
  .product h3 { font-size: 1.3rem; margin-top: 36px; line-height: 1.05; letter-spacing: -0.01em; }
  .product p { font-size: 0.875rem; color: #f6ecf7; line-height: 1.45; flex: 1; }
  .p-btn { display: block; text-align: center; border-radius: 20px; padding: 6px 12px; font-size: 0.8125rem; font-weight: 500; background: var(--p-btn); border: 1px solid var(--p-border); box-shadow: inset 0 -2px 1px rgba(0,0,0,.25); }
  figcaption { margin-top: 12px; font-style: italic; font-weight: 300; color: var(--muted); }
  @media (max-width: 1024px) { .products { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .products { grid-template-columns: 1fr; } .product { min-height: 0; } }
</style>
